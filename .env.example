# Database Connection (Neon PostgreSQL with SSL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage Token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Security & Authentication
AUTH_SECRET="generate_32_bytes_random_hex_key"
GPT_API_KEY="fcf_live_prod_sample_key"
GPT_READONLY_KEY="fcf_live_ro_sample_key"
ADMIN_API_KEY="fcf_live_adm_sample_key"

# Public App URL (No trailing slash)
NEXT_PUBLIC_APP_URL="https://flow-content-factory.vercel.app"
